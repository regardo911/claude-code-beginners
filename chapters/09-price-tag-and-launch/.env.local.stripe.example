# Chapter 9 — the four Stripe values, placeholder-shaped (ch09:32-38).
# Add these to your existing .env.local, alongside the three from Chapter 3.
#
# Every value here comes from YOUR Stripe dashboard. Test keys start sk_test_ / pk_test_;
# live keys start sk_live_ / pk_live_ and Stripe shows the live secret only once.
# The whsec_ value is printed by `stripe listen` on its first run.
#
# Never commit the real file. .gitignore has .env* for exactly this.

STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_PRO_PRICE_ID=price_your_price_id_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Only if you work through the price-raise and annual exercises (ch09:125, ch09:139):
# STRIPE_PRO_PRICE_ID_V2=price_your_new_id_here
# STRIPE_PRO_ANNUAL_PRICE_ID=price_your_annual_id_here
