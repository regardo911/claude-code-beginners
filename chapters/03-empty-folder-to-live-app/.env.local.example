# Chapter 3 — the three lines NextAuth needs (ch03:213-217).
# Copy to .env.local. Never commit the real file: .gitignore has .env* for a reason,
# and a placeholder you commit today is still in your git history after you replace it
# with a real value tomorrow (ch07:76).
#
# Generate NEXTAUTH_SECRET with:  openssl rand -base64 32
# Restart the dev server after editing. It only reads this file at startup.

DATABASE_URL="file:./dev.db"
NEXTAUTH_SECRET=paste-the-string-you-just-generated-here
NEXTAUTH_URL=http://localhost:3000
